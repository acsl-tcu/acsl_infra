#! /usr/bin/bash

cd $ACSL_ROS2_DIR/docker/
echo $(pwd)
source $ACSL_ROS2_DIR/docker/common/scripts/super_echo

# --no-cache を分離
NOCACHE=""
ARGS=()
for arg in "$@"; do
  if [[ "$arg" == "--no-cache" ]]; then
    NOCACHE="--no-cache"
  else
    ARGS+=("$arg")
  fi
done
set -- "${ARGS[@]}"

if [ $# -eq 0 ]; then
  echo "Build docker image"
  echo "[Usage]"
  echo "dbuild  : build image_${PROJECT} from base image using dockerfile.build"
  echo "dbuild drone : build image_drone from base image using dockerfile.build"
  echo "dbuild A B : build image B from image/tag A using dockerfile.build"
  echo "dbuild A B DF : build image B from image/tag A using DF"
  echo "  --no-cache : rebuild without cache"
else
  if [ $# -eq 3 ]; then
    ITAG=$1
    OTAG=$2
    DF=$3
  elif [ $# -eq 2 ]; then
    ITAG=${1}
    OTAG=${2}
    DF=build
  elif [ $# -eq 1 ]; then
    ITAG=base
    OTAG=image_${1}
    DF=build
  fi
  fx86=$(uname -a | grep x86)
  if [[ -n $fx86 ]]; then
    ITAG=${ITAG%_x86}_x86
    OTAG=${OTAG%_x86}_x86
  fi
  if [[ -e $ACSL_ROS2_DIR/dockerfiles/dockerfile.${DF} ]]; then
    DF=$ACSL_ROS2_DIR/dockerfiles/dockerfile.${DF}
  fi
  if [[ -e $ACSL_WORK_DIR/dockerfiles/dockerfile.${DF} ]]; then
    DF=$ACSL_WORK_DIR/dockerfiles/dockerfile.${DF}
  fi
  ftag=$(docker images --format '{{.Repository}}:{{.Tag}}' | grep "^kasekiguchi/acsl-common:$ITAG")
  if [[ -n $ftag ]]; then
    BASE_IMAGE=kasekiguchi/acsl-common:$ITAG
  fi
  ftag=$(docker images --format '{{.Repository}}:{{.Tag}}' | grep "^$ITAG")
  if [[ -n $ftag ]]; then
    BASE_IMAGE=$ITAG
  fi
  gecho "DBUILD: build tag:$OTAG FROM $BASE_IMAGE using $DF ${NOCACHE}"
  DOCKER_BUILDKIT=0 BASE_IMAGE=$BASE_IMAGE OTAG=$OTAG DF=$DF docker compose build ${NOCACHE} image_build
fi
