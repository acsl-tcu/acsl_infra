#! /usr/bin/bash

source $ACSL_ROS2_DIR/docker/common/scripts/super_echo 2>/dev/null

# 環境リポジトリ 1 本を静かに pull する (xargs の並列ワーカとして呼ばれる)。
# 出力するのは「更新があった」「失敗した」場合のみ。更新判定は HEAD の前後比較で
# 行う (git のメッセージ文言はロケールで変わるため、文字列一致に頼らない)。
_gpull_env_repo() {
  local d="$1" before after out
  before=$(git -C "$d" rev-parse HEAD 2>/dev/null)
  if out=$(git -C "$d" pull --ff-only 2>&1); then
    after=$(git -C "$d" rev-parse HEAD 2>/dev/null)
    if [[ "$before" != "$after" ]]; then
      echo "gpull: updated ${d} (${before:0:7}..${after:0:7})"
    fi
  else
    echo "gpull: WARNING pull failed (${d}) — 手元の版を使用します"
    printf '%s\n' "$out" | sed 's/^/    /'
  fi
}
export -f _gpull_env_repo

if [ ${HOSTNAME:0:1} == "D" ]; then
  # docker container 内の場合
  if [[ "$1" == "common" ]]; then
    # ホスト側で gpull common を実行（git pull + setup full）
    /common/scripts/hostbash "$ACSL_ROS2_DIR/docker/common/scripts/gpull $@"
    exit 0
  fi
  /common/scripts/hostbash "$ACSL_ROS2_DIR/docker/common/scripts/gpull $@"
else
  # SBC / ホスト側の場合
  echo $1
  echo "------------------"
  if [[ "$1" == "common" ]]; then
    cd $ACSL_WORK_DIR/common
    echo $(pwd)
    chmod -R u+w $ACSL_WORK_DIR/common/
    git checkout .
    git pull
    chmod -R a+rx,a-w $ACSL_WORK_DIR/common/
    # setup full でメインイメージ + サブイメージを再構築
    cd $ACSL_WORK_DIR
    ./setup full
    exit 0
  fi
  if [[ $# -gt 0 ]]; then
    cd $1
  else
    cd $ACSL_WORK_DIR
  fi
  bashrc=$(ls . | grep bashrc)
  echo $(pwd)
  echo "=========================="
  echo ${bashrc}
  if [[ -v ${bashrc} ]]; then
    echo $(pwd)
    cp -p bashrc ~/tttt
  fi
  git checkout .
  if [[ "$1" == "full" ]]; then
    git pull --recurse-submodules
    git submodule update --init --recursive
  else
    git pull
  fi
  echo "chmod in ${ACSL_WORK_DIR}"
  chmod -R a+x $ACSL_WORK_DIR/launcher/
  chmod -R a+x $ACSL_WORK_DIR/project_launch*
  chmod -R a+x $ACSL_WORK_DIR/stop*
  chmod -R a+x $ACSL_WORK_DIR/setup*
  sed -i "s|\$ACSL_ROS2_DIR|$ACSL_ROS2_DIR|g" $ACSL_WORK_DIR/project_launch*.sh

  if [[ -v $bashrc ]]; then
    echo "chmod in ${ACSL_ROS2_DIR}"
    chmod -R a+x $ACSL_ROS2_DIR/docker/common/
    chmod -R a+x $ACSL_ROS2_DIR/commands/
    mv ~/tttt ./bashrc
  fi

  # --- 環境リポジトリの更新 ---
  # 対象は「そのホストに配備済みのもの全部」。~/ENV はホスト単位の共有アセットで、
  # どの project がどれを使うかは gpull からは判らないため選別しない
  # (「版は固定しない・常に最新運用」= ワークスペース CLAUDE.md の ~/ENV 規約)。
  # 必要な集合を宣言しているのは各 project の setup の ENVIRONMENTS/ROBOTS 配列。
  #
  # 1 リポあたり SSH 往復 ~2 秒で、13 リポ直列では確認だけで ~26 秒かかっていたので
  # 並列化する (ENV_PULL_JOBS で本数を変更可)。出力は差分のみ (既に最新なら黙る)。
  shopt -s nullglob
  declare -A _env_seen=()
  _env_repos=()
  _add_env_repo() {
    local d="$1" key
    [[ -d "$d/.git" ]] || return 0
    key=$(realpath "$d" 2>/dev/null) || key="$d"
    # environments/<name> は ~/ENV/<name>/repo への symlink なので、実体パスで
    # 重複排除しないと同じリポを 2 回 pull することになる
    [[ -n "${_env_seen[$key]:-}" ]] && return 0
    _env_seen[$key]=1
    _env_repos+=("$key")
  }
  # プロジェクト内包型 (旧方式) の残り。共有型への移行完了まで併存
  for env_dir in $ACSL_WORK_DIR/environments/*/; do _add_env_repo "${env_dir%/}"; done
  # ~/ENV/<name>/repo (ホスト共有の環境アセット)
  for env_repo in ${ACSL_ENV_DIR:-$HOME/ENV}/*/repo; do _add_env_repo "$env_repo"; done

  if [[ ${#_env_repos[@]} -gt 0 ]]; then
    _env_log=$(mktemp)
    printf '%s\0' "${_env_repos[@]}" \
      | xargs -0 -P "${ENV_PULL_JOBS:-8}" -I{} bash -c '_gpull_env_repo "$@"' _ {} \
        >"$_env_log" 2>&1
    cat "$_env_log"
    _env_upd=$(grep -c '^gpull: updated ' "$_env_log")
    _env_err=$(grep -c '^gpull: WARNING ' "$_env_log")
    echo "gpull: 環境リポ ${#_env_repos[@]} 件を確認 (更新 ${_env_upd}, 失敗 ${_env_err})"
    rm -f "$_env_log"
  fi
fi
